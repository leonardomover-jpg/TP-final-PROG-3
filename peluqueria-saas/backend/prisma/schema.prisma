// Schema fundacional — Etapa 1 (Análisis y Arquitectura) + Etapa 2 (Auth/RBAC)
// + Etapa 3 (SUPER ADMIN).
// Cubre: Tenant, Branch, User, Role/Permission (RBAC), RefreshToken,
// PlatformAdmin (SUPER ADMIN) + PlatformRefreshToken, Plan, FeatureFlag,
// Subscription, AuditLog, SupportTicket(+Message), Communication.
//
// Diseño detallado y justificación de cada decisión en:
//   ../../docs/02-MULTI-TENANCY-Y-BASE-DE-DATOS.md
//   ../../docs/03-PLANES-FEATURE-FLAGS-SUSCRIPCIONES.md
//   ../../docs/04-SEGURIDAD-BASELINE.md (sección 1: refresh tokens revocables)
//   ../../docs/07-SUPER-ADMIN.md (Etapa 3: MFA obligatorio, lockout, soporte, comunicaciones)
//
// Los módulos de negocio (Client, Service, Professional, Appointment,
// Product, Sale, CashRegister, etc.) se agregan en sus propias etapas,
// siguiendo el mismo patrón: tenantId obligatorio + índice compuesto +
// soft delete donde aplique.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// PLATAFORMA (fuera de cualquier tenant)
// ─────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  active
  suspended
  cancelled
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(active)
  timezone  String       @default("America/Argentina/Buenos_Aires")
  locale    String       @default("es-AR")
  currency  String       @default("ARS")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  branches             Branch[]
  users                User[]
  roles                Role[]
  tenantFeatureFlags   TenantFeatureFlag[]
  subscription         Subscription?
  auditLogs            AuditLog[]
  supportTickets       SupportTicket[]
  communicationTenants CommunicationTenant[]
  clients              Client[]

  @@index([status])
}

model PlatformAdmin {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  status              String    @default("active") // active | suspended
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens PlatformRefreshToken[]
}

model PlatformRefreshToken {
  id              String        @id @default(cuid())
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  tokenHash       String        @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([platformAdminId])
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTIDAD Y ACCESO (tenant-scoped)
// ─────────────────────────────────────────────────────────────────────────

model Branch {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  isMain    Boolean   @default(false)
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userBranches UserBranch[]

  @@index([tenantId])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  firstName    String
  lastName     String
  email        String
  phone        String?
  passwordHash String
  status       String    @default("active") // active | invited | suspended
  lastLoginAt  DateTime?
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branches      UserBranch[]
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
}

model Role {
  id       String  @id @default(cuid())
  tenantId String? // null = rol de sistema predefinido, compartido entre tenants
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  name     String
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // ej. "clientes.crear", "turnos.cancelar", "caja.cerrar"
  module      String // ej. "clientes", "turnos", "caja" — agrupa para la UI
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// ─────────────────────────────────────────────────────────────────────────
// PLANES Y FEATURE FLAGS
// ─────────────────────────────────────────────────────────────────────────

model Plan {
  id                String   @id @default(cuid())
  name              String
  price             Decimal  @db.Decimal(12, 2)
  billingPeriod     String   @default("monthly") // monthly | yearly
  maxUsers          Int
  maxProfessionals  Int
  maxBranches       Int
  maxClients        Int
  status            String   @default("active") // active | archived
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenants       Tenant[]
  features      PlanFeature[]
  communications Communication[]
  subscriptions Subscription[]
}

model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique // ej. "points", "gift_cards", "whatsapp", "ai"
  name            String
  description     String
  globallyEnabled Boolean  @default(false)
  dependsOnKey    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plans   PlanFeature[]
  tenants TenantFeatureFlag[]
}

model PlanFeature {
  planId        String
  plan          Plan        @relation(fields: [planId], references: [id])
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])

  @@id([planId, featureFlagId])
}

model TenantFeatureFlag {
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])
  enabled       Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@id([tenantId, featureFlagId])
}

// ─────────────────────────────────────────────────────────────────────────
// SUSCRIPCIONES (billing de la plataforma, no confundir con pagos a clientes)
// ─────────────────────────────────────────────────────────────────────────

model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  status             String    @default("trial") // trial | active | past_due | expiring_soon | suspended | cancelled
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments SubscriptionPayment[]

  @@index([status])
}

model SubscriptionPayment {
  id               String       @id @default(cuid())
  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id])
  provider         String       // "mercado_pago"
  providerPaymentId String
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("ARS")
  status           String       // pending | approved | rejected | refunded
  rawPayload       Json
  createdAt        DateTime     @default(now())

  @@unique([provider, providerPaymentId])
  @@index([subscriptionId])
}

// ─────────────────────────────────────────────────────────────────────────
// CLIENTES / CRM (Etapa 6)
// ─────────────────────────────────────────────────────────────────────────

// Sin @@unique en email/phone a propósito (a diferencia de User): un
// cliente no es una identidad de login, y duplicados son plausibles (ej.
// un teléfono familiar compartido) — doc `10-CLIENTES.md` §4.
model Client {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  firstName String
  lastName  String
  phone     String?
  email     String?
  birthDate DateTime?
  notes     String? // observaciones generales, distinto del historial de ClientNote
  status    String    @default("active") // active | inactive
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clientNotes ClientNote[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

// Notas internas con autor y fecha, separadas del campo `notes` general de
// Client (que es un único texto libre) — permite un historial de
// observaciones agregadas por distintos empleados a lo largo del tiempo.
model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────
// AUDITORÍA (transversal)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String? // null = acción de SUPER ADMIN sobre la plataforma
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actorType  String   // user | platform_admin | system | webhook
  actorId    String?
  action     String   // ej. "service.price.updated", "user.login"
  entityType String?
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────
// SOPORTE (punto 59 del pedido: negocio abre tickets, SUPER ADMIN los gestiona)
// ─────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  subject           String
  status            String    @default("open") // open | in_progress | resolved | closed
  priority          String    @default("medium") // low | medium | high
  createdByUserId   String
  assignedToAdminId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  messages SupportTicketMessage[]

  @@index([tenantId])
  @@index([status])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorType String        // user | platform_admin
  authorId   String
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

// ─────────────────────────────────────────────────────────────────────────
// COMUNICACIONES GLOBALES (punto 60 del pedido)
// ─────────────────────────────────────────────────────────────────────────

model Communication {
  id               String   @id @default(cuid())
  title            String
  body             String
  audienceType     String   // all | plan | tenants
  planId           String?
  plan             Plan?    @relation(fields: [planId], references: [id])
  createdByAdminId String
  createdAt        DateTime @default(now())

  tenants CommunicationTenant[]
}

// Solo se usa cuando audienceType = "tenants" (negocios puntuales elegidos
// a mano por SUPER ADMIN). Si audienceType es "all" o "plan", esta tabla
// queda vacía para esa comunicación — el filtro se resuelve en runtime.
model CommunicationTenant {
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id])
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])

  @@id([communicationId, tenantId])
}
