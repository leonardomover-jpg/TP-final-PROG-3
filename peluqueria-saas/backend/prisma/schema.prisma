// Schema fundacional — Etapa 1 (Análisis y Arquitectura) + Etapa 2 (Auth/RBAC)
// + Etapa 3 (SUPER ADMIN).
// Cubre: Tenant, Branch, User, Role/Permission (RBAC), RefreshToken,
// PlatformAdmin (SUPER ADMIN) + PlatformRefreshToken, Plan, FeatureFlag,
// Subscription, AuditLog, SupportTicket(+Message), Communication.
//
// Diseño detallado y justificación de cada decisión en:
//   ../../docs/02-MULTI-TENANCY-Y-BASE-DE-DATOS.md
//   ../../docs/03-PLANES-FEATURE-FLAGS-SUSCRIPCIONES.md
//   ../../docs/04-SEGURIDAD-BASELINE.md (sección 1: refresh tokens revocables)
//   ../../docs/07-SUPER-ADMIN.md (Etapa 3: MFA obligatorio, lockout, soporte, comunicaciones)
//
// Los módulos de negocio (Client, Service, Professional, Appointment,
// Product, Sale, CashRegister, etc.) se agregan en sus propias etapas,
// siguiendo el mismo patrón: tenantId obligatorio + índice compuesto +
// soft delete donde aplique.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// PLATAFORMA (fuera de cualquier tenant)
// ─────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  active
  suspended
  cancelled
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(active)
  timezone  String       @default("America/Argentina/Buenos_Aires")
  locale    String       @default("es-AR")
  currency  String       @default("ARS")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  branches                  Branch[]
  users                     User[]
  roles                     Role[]
  tenantFeatureFlags        TenantFeatureFlag[]
  subscription              Subscription?
  auditLogs                 AuditLog[]
  supportTickets            SupportTicket[]
  communicationTenants      CommunicationTenant[]
  clients                   Client[]
  professionals             Professional[]
  services                  Service[]
  scheduleExceptions        ScheduleException[]
  holidayOverrides          TenantHolidayOverride[]
  appointments              Appointment[]
  waitlistEntries           WaitlistEntry[]
  products                  Product[]
  suppliers                 Supplier[]
  purchases                 Purchase[]
  cashRegisters             CashRegister[]
  sales                     Sale[]
  expenses                  Expense[]
  loyaltyPointsTransactions LoyaltyPointsTransaction[]
  giftCards                 GiftCard[]
  referrals                 Referral[]
  promotions                Promotion[]
  notifications             Notification[]
  integrations              TenantIntegration[]
  deposits                  Deposit[]

  @@index([status])
}

model PlatformAdmin {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  status              String    @default("active") // active | suspended
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens PlatformRefreshToken[]
}

model PlatformRefreshToken {
  id              String        @id @default(cuid())
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  tokenHash       String        @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([platformAdminId])
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTIDAD Y ACCESO (tenant-scoped)
// ─────────────────────────────────────────────────────────────────────────

model Branch {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  isMain    Boolean   @default(false)
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userBranches    UserBranch[]
  schedules       BranchSchedule[]
  exceptions      ScheduleException[]
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  cashRegisters   CashRegister[]
  sales           Sale[]
  expenses        Expense[]

  @@index([tenantId])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  firstName    String
  lastName     String
  email        String
  phone        String?
  passwordHash String
  status       String    @default("active") // active | invited | suspended
  lastLoginAt  DateTime?
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branches           UserBranch[]
  roles              UserRole[]
  refreshTokens      RefreshToken[]
  professional       Professional?
  notifications      Notification[]
  communicationReads CommunicationRead[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
}

model Role {
  id       String  @id @default(cuid())
  tenantId String? // null = rol de sistema predefinido, compartido entre tenants
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  name     String
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // ej. "clientes.crear", "turnos.cancelar", "caja.cerrar"
  module      String // ej. "clientes", "turnos", "caja" — agrupa para la UI
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// ─────────────────────────────────────────────────────────────────────────
// PLANES Y FEATURE FLAGS
// ─────────────────────────────────────────────────────────────────────────

model Plan {
  id               String   @id @default(cuid())
  name             String
  price            Decimal  @db.Decimal(12, 2)
  billingPeriod    String   @default("monthly") // monthly | yearly
  maxUsers         Int
  maxProfessionals Int
  maxBranches      Int
  maxClients       Int
  status           String   @default("active") // active | archived
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenants        Tenant[]
  features       PlanFeature[]
  communications Communication[]
  subscriptions  Subscription[]
}

model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique // ej. "points", "gift_cards", "whatsapp", "ai"
  name            String
  description     String
  globallyEnabled Boolean  @default(false)
  dependsOnKey    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plans   PlanFeature[]
  tenants TenantFeatureFlag[]
}

model PlanFeature {
  planId        String
  plan          Plan        @relation(fields: [planId], references: [id])
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])

  @@id([planId, featureFlagId])
}

model TenantFeatureFlag {
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])
  enabled       Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@id([tenantId, featureFlagId])
}

// ─────────────────────────────────────────────────────────────────────────
// SUSCRIPCIONES (billing de la plataforma, no confundir con pagos a clientes)
// ─────────────────────────────────────────────────────────────────────────

model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  status             String    @default("trial") // trial | active | past_due | expiring_soon | suspended | cancelled
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments SubscriptionPayment[]

  @@index([status])
}

model SubscriptionPayment {
  id                String       @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  provider          String // "mercado_pago"
  providerPaymentId String
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("ARS")
  status            String // pending | approved | rejected | refunded
  rawPayload        Json
  createdAt         DateTime     @default(now())

  @@unique([provider, providerPaymentId])
  @@index([subscriptionId])
}

// ─────────────────────────────────────────────────────────────────────────
// CLIENTES / CRM (Etapa 6)
// ─────────────────────────────────────────────────────────────────────────

// Sin @@unique en email/phone a propósito (a diferencia de User): un
// cliente no es una identidad de login, y duplicados son plausibles (ej.
// un teléfono familiar compartido) — doc `10-CLIENTES.md` §4.
model Client {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  firstName String
  lastName  String
  phone     String?
  email     String?
  birthDate DateTime?
  notes     String? // observaciones generales, distinto del historial de ClientNote
  status    String    @default("active") // active | inactive
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Balance cacheado de puntos (Etapa 13) — el historial real vive en
  // LoyaltyPointsTransaction; este campo es la suma acumulada, mantenida
  // en la misma transacción que cada movimiento (evita sumar el ledger
  // completo en cada lectura).
  loyaltyPoints Int @default(0)

  clientNotes               ClientNote[]
  appointments              Appointment[]
  waitlistEntries           WaitlistEntry[]
  sales                     Sale[]
  loyaltyPointsTransactions LoyaltyPointsTransaction[]
  giftCards                 GiftCard[]
  referralsMade             Referral[]                 @relation("ReferralsMade")
  referralsReceived         Referral[]                 @relation("ReferralsReceived")

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

// Notas internas con autor y fecha, separadas del campo `notes` general de
// Client (que es un único texto libre) — permite un historial de
// observaciones agregadas por distintos empleados a lo largo del tiempo.
model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────
// PROFESIONALES (Etapa 7)
// ─────────────────────────────────────────────────────────────────────────

// El vínculo a User es OPCIONAL a propósito (punto de la Etapa 7 del
// roadmap: "vínculo opcional a User"): un profesional puede ser alguien
// que factura/trabaja en el negocio sin tener acceso al sistema (sin
// login propio), y viceversa, un User (ej. el dueño) no necesariamente es
// un profesional que atiende clientes. Cuando SÍ está vinculado, es 1:1
// (@unique en userId) — un profesional no puede "ser" dos Users distintos,
// y un User no puede tener dos fichas de profesional.
model Professional {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  userId               String?   @unique
  user                 User?     @relation(fields: [userId], references: [id])
  firstName            String
  lastName             String
  phone                String?
  email                String?
  specialties          String[] // tags libres (ej. "corte", "color", "barba") — el catálogo
  // formal de Servicios y "profesionales habilitados por servicio" es de la Etapa 8.
  commissionPercentage Decimal?  @db.Decimal(5, 2) // % sobre venta/servicio, null = sin comisión configurada
  status               String    @default("active") // active | inactive
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  schedules       ProfessionalSchedule[]
  services        ServiceProfessional[]
  exceptions      ScheduleException[]
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  sales           Sale[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

// Horario semanal recurrente PROPIO del profesional (punto "horarios
// propios" de la Etapa 7). Deliberadamente simple: un rango por día de la
// semana, sin excepciones ni feriados — eso es el motor de disponibilidad
// completo de la Etapa 9 (horario del negocio, excepciones, feriados
// argentinos), que va a combinarse con esta tabla, no reemplazarla.
model ProfessionalSchedule {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  dayOfWeek      Int // 0 = domingo … 6 = sábado (getDay() de JS)
  startTime      String // "HH:mm", 24hs
  endTime        String // "HH:mm", 24hs

  @@index([professionalId])
}

// ─────────────────────────────────────────────────────────────────────────
// SERVICIOS (Etapa 8)
// ─────────────────────────────────────────────────────────────────────────

// `category` es un tag libre (igual que `Professional.specialties`, doc
// `11-PROFESIONALES.md` §3), no un catálogo separado: no hay ningún caso de
// uso todavía (gestionar/reordenar/traducir categorías) que justifique una
// tabla propia — si aparece, se agrega ahí, no antes (punto 95 del pedido:
// no inventar estructura sin necesidad concreta).
model Service {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  category        String?
  durationMinutes Int
  price           Decimal   @db.Decimal(12, 2)
  status          String    @default("active") // active | inactive
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  professionals   ServiceProfessional[]
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  saleItems       SaleItem[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

// "Profesionales habilitados" para un servicio (punto de la Etapa 8 del
// roadmap) — M:N entre Service y Professional. Sin tenantId propio (ambos
// extremos ya son tenant-scoped): ServicesService valida que Service Y
// cada Professional pertenezcan al tenant actual antes de escribir acá,
// mismo patrón que Professional.userId con User (doc `11` §3).
model ServiceProfessional {
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@id([serviceId, professionalId])
  @@index([professionalId])
}

// ─────────────────────────────────────────────────────────────────────────
// HORARIOS (Etapa 9)
// ─────────────────────────────────────────────────────────────────────────

// Horario semanal recurrente del NEGOCIO, por sucursal (mismo shape que
// ProfessionalSchedule de la Etapa 7 — mismo motivo: un rango por día de
// la semana, sin excepciones ni feriados, eso son las dos tablas de abajo).
model BranchSchedule {
  id        String @id @default(cuid())
  branchId  String
  branch    Branch @relation(fields: [branchId], references: [id])
  dayOfWeek Int // 0 = domingo … 6 = sábado (getDay() de JS)
  startTime String // "HH:mm", 24hs
  endTime   String // "HH:mm", 24hs

  @@index([branchId])
}

// Excepción puntual para UNA fecha concreta: "cerrado todo el día" (ej.
// vacaciones de un profesional, la sucursal cierra por refacción) o
// "horario distinto al habitual" (ej. el sábado previo a un feriado se
// abre más tarde). Se aplica a la sucursal O a un profesional — nunca
// ambos ni ninguno; ScheduleService valida esa regla (XOR) porque Prisma
// no expresa una constraint de ese tipo declarativamente sin SQL a mano,
// y agregar SQL crudo a la migración por esto no se justifica todavía.
model ScheduleException {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  date           DateTime      @db.Date
  isClosed       Boolean       @default(true)
  startTime      String? // solo si isClosed = false (horario distinto al habitual)
  endTime        String?
  reason         String?
  createdAt      DateTime      @default(now())

  @@index([tenantId])
  @@index([branchId, date])
  @@index([professionalId, date])
}

// Catálogo GLOBAL de feriados argentinos (gestionado por SUPER ADMIN,
// mismo patrón que FeatureFlag — un solo catálogo compartido entre todos
// los negocios, no algo que cada tenant carga por su cuenta). Se seedea
// con fechas concretas de un año dado porque varios feriados argentinos
// son "trasladables" por decreto (no son la misma fecha todos los años) —
// doc `13-HORARIOS.md` §3: hay que re-sembrar/actualizar el catálogo cada
// año, no es un cálculo automático.
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantOverrides TenantHolidayOverride[]

  @@unique([date])
  @@index([year])
}

// Override MANUAL por negocio de un feriado del catálogo (punto de la
// Etapa 9 del roadmap: "feriados argentinos con override manual por
// negocio"): por default, sin fila acá, el negocio se considera CERRADO
// ese día (mismo criterio conservador que un ScheduleException sin
// horario específico). Un negocio que sí abre ese feriado (ej. una
// peluquería que trabaja el Día de la Independencia) crea una fila con
// isOpen=true.
model TenantHolidayOverride {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  holidayId String
  holiday   Holiday  @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  isOpen    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@id([tenantId, holidayId])
}

// ─────────────────────────────────────────────────────────────────────────
// AGENDA Y TURNOS (Etapa 10)
// ─────────────────────────────────────────────────────────────────────────

// Un turno = un servicio con un profesional, en una sucursal, para un
// cliente. `endAt` se guarda calculado (startAt + Service.durationMinutes
// al momento de la reserva) en vez de derivarse en cada lectura — así un
// cambio posterior en la duración del servicio no reescribe turnos ya
// tomados (doc `14-AGENDA-TURNOS.md` §3). Sin soporte para "un turno con
// varios servicios" en esta etapa (ver doc §7) — cada turno es un
// servicio; un cliente que quiere corte + color reserva dos turnos
// consecutivos, que el motor de disponibilidad ya evita que se
// superpongan con otros turnos de ESE profesional.
model Appointment {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  startAt        DateTime
  endAt          DateTime
  status         String       @default("pending") // pending | confirmed | completed | cancelled | no_show
  notes          String?
  cancelReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deposit Deposit?

  @@index([tenantId])
  @@index([professionalId, startAt])
  @@index([branchId, startAt])
  @@index([clientId])
}

// Lista de espera (punto de la Etapa 10 del roadmap): un cliente que
// quiere un turno pero no hay disponibilidad en la fecha que prefiere.
// Sin motor de "auto-oferta" cuando se libera un lugar en esta etapa — es
// una cola visible que el negocio gestiona a mano (llama al cliente, lo
// convierte en turno); automatizar eso es Notificaciones (Etapa 14).
model WaitlistEntry {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  preferredDate  DateTime?     @db.Date
  notes          String?
  status         String        @default("waiting") // waiting | booked | cancelled
  createdAt      DateTime      @default(now())

  @@index([tenantId])
  @@index([tenantId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// PRODUCTOS E INVENTARIO (Etapa 11)
// ─────────────────────────────────────────────────────────────────────────

// Primer módulo opcional gateado de verdad por el FeatureFlagGuard/
// @RequiresFeature construido en la Etapa 4 (doc `08` §3) — hasta ahora
// esa infraestructura no tenía ningún consumidor real. `inventory` ya
// estaba en el catálogo de feature flags sembrado desde la Etapa 2.
model Product {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  sku         String?
  description String?
  category    String? // tag libre, mismo criterio que Service.category (doc `12` §3)
  price       Decimal   @db.Decimal(12, 2) // precio de venta
  cost        Decimal?  @db.Decimal(12, 2) // costo de la última compra recibida
  unit        String    @default("unidad") // "unidad", "ml", "kg", etc.
  stock       Int       @default(0)
  minStock    Int       @default(0) // umbral para la alerta de stock bajo
  status      String    @default("active") // active | inactive
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  // sku es opcional pero, cuando se carga, tiene que ser único dentro del
  // tenant — Postgres no exige unicidad entre múltiples NULLs, así que
  // varios productos sin sku conviven sin problema.
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model Supplier {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  status      String    @default("active") // active | inactive
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  purchases Purchase[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

// Una compra a un proveedor. `pending` no afecta stock todavía — recién al
// pasar a `received` (PurchasesService.receive, en una transacción) se
// incrementa Product.stock de cada ítem y se actualiza Product.cost con el
// último unitCost. Sin edición de ítems después de creada (el flujo es
// crear con los ítems finales → recibir o cancelar) — si hace falta
// corregir una compra ya recibida, se registra como ajuste de stock
// manual (`POST /products/:id/stock-adjustment`), no reabriendo la compra.
model Purchase {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  status     String    @default("pending") // pending | received | cancelled
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  receivedAt DateTime?

  items PurchaseItem[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────
// VENTAS, CAJA Y GASTOS (Etapa 12)
// ─────────────────────────────────────────────────────────────────────────

// Un turno de caja: abre con un monto declarado, cierra contando el
// efectivo real. `expectedCashAmount`/`difference` se calculan recién al
// cerrar (CashRegisterService.close), nunca antes — no tiene sentido
// "cuánto debería haber" hasta que se sabe qué pasó en toda la sesión.
model CashRegister {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  branchId           String
  branch             Branch    @relation(fields: [branchId], references: [id])
  status             String    @default("open") // open | closed
  openedByUserId     String
  openingAmount      Decimal   @db.Decimal(12, 2)
  openedAt           DateTime  @default(now())
  closedByUserId     String?
  closingAmount      Decimal?  @db.Decimal(12, 2) // efectivo contado a mano
  expectedCashAmount Decimal?  @db.Decimal(12, 2) // openingAmount + ventas en efectivo - gastos en efectivo
  difference         Decimal?  @db.Decimal(12, 2) // closingAmount - expectedCashAmount
  closedAt           DateTime?
  notes              String?

  sales    Sale[]
  expenses Expense[]

  @@index([tenantId])
  @@index([branchId, status])
}

// Una venta mixta (servicios + productos) de un turno de caja abierto.
// `total` se guarda calculado — suma de los `subtotal` de los ítems al
// momento de la venta — por el mismo motivo que `Appointment.endAt`
// (Etapa 10, doc `14` §3): no se recalcula solo si el catálogo cambia
// después.
model Sale {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id])
  professionalId String? // quién atendió — usado para el cálculo de comisiones
  professional   Professional? @relation(fields: [professionalId], references: [id])
  status         String        @default("completed") // completed | cancelled
  total          Decimal       @db.Decimal(12, 2)
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    SaleItem[]
  payments SalePayment[]

  @@index([tenantId])
  @@index([cashRegisterId])
  @@index([professionalId])
  @@index([clientId])
}

// `name`/`unitPrice` son una FOTO del catálogo al momento de la venta
// (nunca el precio que mande el cliente — se toma siempre de
// Service.price/Product.price en el server, mismo principio que "no
// confiar en el cliente para montos de dinero" ya aplicado con Mercado
// Pago en la Etapa 5). Exactamente uno de serviceId/productId.
model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  itemType  String // service | product
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)

  @@index([saleId])
}

// Pagos combinados (punto de la Etapa 12 del roadmap): una venta puede
// tener más de una fila acá (ej. mitad efectivo, mitad tarjeta) — la suma
// de `amount` tiene que ser exactamente `Sale.total`, validado en
// SalesService.create antes de escribir nada.
model SalePayment {
  id     String  @id @default(cuid())
  saleId String
  sale   Sale    @relation(fields: [saleId], references: [id])
  method String // cash | card | transfer | other
  amount Decimal @db.Decimal(12, 2)

  @@index([saleId])
}

// Gasto categorizado (categoría como tag libre, mismo criterio que
// Service.category/Product.category). `cashRegisterId` es opcional: solo
// se completa cuando el gasto salió del efectivo de una caja abierta (así
// entra en el arqueo al cerrar) — un gasto pagado por transferencia no
// tiene por qué estar atado a una caja.
model Expense {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  category       String?
  amount         Decimal       @db.Decimal(12, 2)
  description    String?
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([tenantId])
  @@index([cashRegisterId])
}

// ─────────────────────────────────────────────────────────────────────────
// FIDELIZACIÓN (Etapa 13) — Puntos, Gift Cards, Referidos, Promociones
// ─────────────────────────────────────────────────────────────────────────
// Los cuatro sub-módulos van cada uno detrás de su propio feature flag
// ("points", "gift_cards", "referrals", ya sembrados desde la Etapa 2;
// "promotions" se agrega recién en esta etapa porque no existía en el
// catálogo original) — mismo patrón de gateo real ya estrenado con
// "inventory" en la Etapa 11. Ninguno de los cuatro se dispara
// automáticamente desde una Sale (ej. "ganar puntos al vender"): es
// gestión manual vía sus propios endpoints — enganchar esto a
// SalesService.create es una integración real que se hace cuando el
// pedido la pida en concreto, no antes (doc `17-FIDELIZACION.md` §6).

// Balance cacheado en Client.loyaltyPoints (ver más abajo) + un ledger de
// movimientos para el historial — mismo criterio que Product.stock +
// ajuste manual (Etapa 11), pero acá con ledger porque el "por qué" de
// cada movimiento de puntos sí importa para el cliente final.
model LoyaltyPointsTransaction {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  delta     Int // positivo = otorgados, negativo = canjeados
  reason    String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([clientId])
}

// `code` es el identificador que el cliente presenta para canjear —
// único por tenant, generado por el servidor (nunca elegido por quien la
// emite, para no permitir códigos predecibles o duplicados a propósito).
model GiftCard {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  code           String
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  initialBalance Decimal   @db.Decimal(12, 2)
  balance        Decimal   @db.Decimal(12, 2)
  status         String    @default("active") // active | redeemed | cancelled
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transactions GiftCardTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model GiftCardTransaction {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  amount     Decimal  @db.Decimal(12, 2) // siempre positivo; el tipo de movimiento lo da `reason`
  reason     String // ej. "canje", "emisión"
  createdAt  DateTime @default(now())

  @@index([giftCardId])
}

// Un cliente existente (`referrerClientId`) trae a alguien nuevo
// (`referredClientId`). `status` empieza en `pending` y se marca
// `completed` a mano (ej. cuando el referido hace su primera compra) —
// sin automatizar esa transición todavía, mismo motivo que el resto del
// módulo (ver comentario de la sección).
model Referral {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  referrerClientId String
  referrerClient   Client   @relation("ReferralsMade", fields: [referrerClientId], references: [id])
  referredClientId String
  referredClient   Client   @relation("ReferralsReceived", fields: [referredClientId], references: [id])
  status           String   @default("pending") // pending | completed
  rewardPoints     Int?
  createdAt        DateTime @default(now())

  @@unique([tenantId, referredClientId]) // un cliente solo puede haber sido referido una vez
  @@index([tenantId])
  @@index([referrerClientId])
}

// Definición de una promoción/descuento (código opcional). Sin aplicación
// automática a una Sale en esta etapa — ver comentario de la sección.
model Promotion {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  name          String
  code          String?
  discountType  String // percentage | fixed
  discountValue Decimal   @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  status        String    @default("active") // active | inactive
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────
// AUDITORÍA (transversal)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String? // null = acción de SUPER ADMIN sobre la plataforma
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actorType  String // user | platform_admin | system | webhook
  actorId    String?
  action     String // ej. "service.price.updated", "user.login"
  entityType String?
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────
// SOPORTE (punto 59 del pedido: negocio abre tickets, SUPER ADMIN los gestiona)
// ─────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  subject           String
  status            String   @default("open") // open | in_progress | resolved | closed
  priority          String   @default("medium") // low | medium | high
  createdByUserId   String
  assignedToAdminId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages SupportTicketMessage[]

  @@index([tenantId])
  @@index([status])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorType String // user | platform_admin
  authorId   String
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

// ─────────────────────────────────────────────────────────────────────────
// COMUNICACIONES GLOBALES (punto 60 del pedido)
// ─────────────────────────────────────────────────────────────────────────

model Communication {
  id               String   @id @default(cuid())
  title            String
  body             String
  audienceType     String // all | plan | tenants
  planId           String?
  plan             Plan?    @relation(fields: [planId], references: [id])
  createdByAdminId String
  createdAt        DateTime @default(now())

  tenants CommunicationTenant[]
  reads   CommunicationRead[]
}

// Solo se usa cuando audienceType = "tenants" (negocios puntuales elegidos
// a mano por SUPER ADMIN). Si audienceType es "all" o "plan", esta tabla
// queda vacía para esa comunicación — el filtro se resuelve en runtime.
model CommunicationTenant {
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id])
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])

  @@id([communicationId, tenantId])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICACIONES (Etapa 14) — Centro de notificaciones + canales internos
// ─────────────────────────────────────────────────────────────────────────
// `Notification` es el "buzón" propio de cada User, generado por el
// backend ante eventos internos (stock bajo, uso del plan cerca del
// límite) — nunca por el cliente vía API. `CommunicationRead` es solo el
// marcador de lectura de una Comunicación global (Etapa 3) por parte de
// un User puntual: la Comunicación en sí no se duplica por usuario, se
// resuelve en runtime (mismo criterio que la jerarquía de Feature Flags)
// y se cruza con esta tabla para saber si ESTE usuario ya la vio. Ver
// doc `18-NOTIFICACIONES.md` para el detalle de qué eventos disparan qué.

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // low_stock | plan_limit_warning
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
}

// Sin tenantId propio a propósito (doc `18` §5): userId ya identifica de
// forma inequívoca a un User concreto de un tenant concreto, y el único
// lugar que escribe acá es NotificationsService, siempre con el userId
// del usuario autenticado — no hay ningún ID de otro tenant que "adivinar".
model CommunicationRead {
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id])
  readAt          DateTime      @default(now())

  @@id([userId, communicationId])
}

// ─────────────────────────────────────────────────────────────────────────
// MERCADO PAGO PARA CLIENTES (Etapa 15) — Integraciones por tenant + Señas
// ─────────────────────────────────────────────────────────────────────────
// Cada NEGOCIO conecta su PROPIA cuenta de Mercado Pago acá — no confundir
// con `MercadoPagoService`/las env vars `MERCADO_PAGO_*` (Etapa 5), que son
// la cuenta de LA PLATAFORMA para cobrar la suscripción SaaS. Las
// credenciales reales nunca se guardan en texto plano (doc
// `05-OBSERVACIONES-Y-RIESGOS.md` §6): `encryptedAccessToken`/
// `encryptedWebhookSecret` están cifradas con AES-256-GCM
// (`src/common/crypto/tenant-secret-cipher.ts`), y solo se descifran en
// memoria justo antes de llamar a la API de Mercado Pago o de verificar
// una firma de webhook — nunca se devuelven en una respuesta HTTP.

model TenantIntegration {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  provider               String // "mercado_pago" (whatsapp/instagram/facebook en etapas futuras)
  status                 String    @default("disconnected") // connected | disconnected
  publicKey              String? // no es secreto — se puede exponer al frontend si hace falta
  encryptedAccessToken   String?
  encryptedWebhookSecret String?
  connectedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// Seña (adelanto) para confirmar un turno — 1:1 con Appointment. El
// checkout lo genera el negocio (POST /deposits) con la cuenta de Mercado
// Pago de ESE tenant y comparte el link con el cliente por el canal que
// tenga hoy (todavía no hay página pública, Etapa 18); el estado real
// SIEMPRE se confirma vía webhook + GET /v1/payments (nunca por lo que
// declare el cliente) — mismo principio ya aplicado en Suscripciones
// (Etapa 5) y en Ventas (Etapa 12: "nunca confiar en el cliente para
// montos de dinero").
model Deposit {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  amount         Decimal     @db.Decimal(12, 2)
  status         String      @default("pending") // pending | approved | rejected | cancelled
  mpPreferenceId String?
  mpPaymentId    String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([tenantId])
}
