# Copiar a .env y completar con valores reales. Nunca commitear .env real.

DATABASE_URL="postgresql://usuario:password@localhost:5432/peluqueria_saas"

# Auth de negocio (Etapa 2) — requeridas.
JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-y-aleatorio-distinto"

# Auth de SUPER ADMIN (Etapa 3) — requeridas, y DEBEN ser distintas de las
# de arriba: un token de negocio nunca debe poder validar acá ni viceversa.
PLATFORM_ADMIN_JWT_ACCESS_SECRET="cambiar-por-un-tercer-secreto-largo-y-aleatorio"
PLATFORM_ADMIN_JWT_REFRESH_SECRET="cambiar-por-un-cuarto-secreto-largo-y-aleatorio"

# Bootstrap del primer SUPER ADMIN (Etapa 3): solo se usan al correr
# `npm run prisma:seed`. No hay endpoint público para crear un PlatformAdmin
# (sería un agujero de seguridad) — esta es la única vía.
SUPER_ADMIN_BOOTSTRAP_EMAIL="admin@tu-plataforma.com"
SUPER_ADMIN_BOOTSTRAP_PASSWORD="cambiar-por-una-password-fuerte"

PORT=3000

# URL pública del backend (para armar notification_url de los webhooks de
# Mercado Pago). Sin esto, los checkouts se crean igual pero sin
# notification_url — Mercado Pago no va a poder avisar los pagos. También
# la usa el QR de la página pública (Etapa 18): sin proyecto de frontend
# todavía, el QR apunta al propio endpoint JSON del catálogo
# (GET /public/:tenantSlug) como placeholder — ver docs/22-PAGINA-PUBLICA-QR-PWA.md.
APP_PUBLIC_URL="https://tu-backend-publico.com"

# Mercado Pago (Etapa 5) — cuenta de LA PLATAFORMA, cobra la suscripción
# SaaS a cada negocio (no confundir con Mercado Pago de un negocio para
# cobrarle a SUS clientes, eso es la Etapa 15). Usar credenciales de TEST
# (public/access token que empiezan con TEST-) mientras se desarrolla.
MERCADO_PAGO_ACCESS_TOKEN="cambiar-por-el-access-token-de-mercado-pago"
# Clave secreta de webhook configurada en "Tus integraciones" del dashboard
# de Mercado Pago — se usa para validar la firma x-signature.
MERCADO_PAGO_WEBHOOK_SECRET="cambiar-por-el-webhook-secret-de-mercado-pago"
# Opcional: override de la base URL de la API (útil para apuntar a un mock
# en tests). Si no se define, usa https://api.mercadopago.com.
# MERCADO_PAGO_BASE_URL=

# Mercado Pago PARA CLIENTES (Etapa 15) — cada negocio conecta SU PROPIA
# cuenta (access token + public key + webhook secret propios, ver
# POST /integrations/mercado-pago/connect), guardados cifrados en
# TenantIntegration. Esta clave es la de LA PLATAFORMA que cifra/descifra
# esas credenciales — generarla con `openssl rand -hex 32` (32 bytes en
# hex) y nunca reutilizarla como ninguno de los otros secretos de arriba.
TENANT_SECRETS_ENCRYPTION_KEY="cambiar-por-32-bytes-en-hex-openssl-rand--hex-32"

# WhatsApp (Etapa 16) — igual que Mercado Pago para clientes, cada negocio
# conecta SU PROPIA cuenta de WhatsApp Business (Meta Cloud API) vía
# POST /integrations/whatsapp/connect; no hay credenciales de plataforma
# acá. Opcional: override de la base URL de la API (útil para apuntar a un
# mock en tests). Si no se define, usa https://graph.facebook.com/v21.0.
# WHATSAPP_API_BASE_URL=

# Facebook / Instagram (Etapa 17) — mismo criterio: cada negocio conecta
# SU PROPIA Página de Facebook / cuenta de Instagram Business vía
# POST /integrations/facebook/connect y /integrations/instagram/connect.
# Opcional: override de la base URL de la Graph API. Si no se define, usa
# https://graph.facebook.com/v21.0.
# META_GRAPH_API_BASE_URL=

# IA (Etapa 21, gateada por el feature flag "ai") — a diferencia de
# Mercado Pago/WhatsApp/Meta, es una cuenta DE LA PLATAFORMA (no cada
# negocio conecta la suya): GET /ai/insights arma un resumen SOLO con los
# datos del tenant que hace la request (nunca cruza negocios) y se lo
# manda a la API de Anthropic (Claude) para generar insights en texto.
# Sin esta clave, el endpoint responde 500 con un mensaje claro.
AI_API_KEY="cambiar-por-una-api-key-de-Anthropic"
# Opcionales — si no se definen, usan https://api.anthropic.com y
# claude-3-5-haiku-latest respectivamente.
# AI_API_BASE_URL=
# AI_MODEL=

# Se agregan en etapas siguientes (jobs, etc.):
# REDIS_URL=
